# Copy this file to ".env" and paste ONE API key below.
# If GEMINI_API_KEY is set, the app uses Gemini; otherwise it uses Claude.

# Option A - Gemini (has a free tier).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: another Gemini model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Option B - Claude (paid, prepaid credits).
# Get a key at https://platform.claude.com/ (Settings > API Keys).
# Never share your .env file or commit it to git!
ANTHROPIC_API_KEY=

# Optional: the port for the backend server (default 3001)
# PORT=3001
